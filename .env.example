# Agent Games — environment variables.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Values come from the dashboard: https://agentgames.zkverify.io/dashboard

# Port the server listens on (hosting platforms inject PORT).
PORT=8080

# HMAC secret from the dashboard ("Rotate Secret"). REQUIRED before going live.
# Without it, inbound HMAC verification is disabled (health shows it).
# The value below is a LOCAL TEST SECRET ONLY — used by test-live.js.
# NEVER put the real dashboard secret in this file or in git.
AGENT_GAMES_HMAC_SECRET=local-test-secret-only-never-the-real-one

# HMAC encoding: hex (default) or sha256= (if the platform rejects preflight).
AGENT_GAMES_HMAC_FORMAT=hex

# Gatekeeper taskId mapping: keccak (default), numeric, or hex.
# See gatekeeper/prove.js — confirm against a practice task.
GATEKEEPER_TASK_ID_MODE=keccak
